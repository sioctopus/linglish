# Copy this file to .env and set a random AUTH_TOKEN_SECRET before starting.
# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SITE_URL=http://localhost:4000
# Database Configuration
DATABASE_URL=postgres://localhost:5432/linglish

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_GPT4=gpt-4o
OPENAI_MODEL_GPT35=gpt-4o
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=1.0
OPENAI_TOP_P=1.0
OPENAI_FREQUENCY_PENALTY=0.0
OPENAI_PRESENCE_PENALTY=0.0

# Proxy Configuration
# This proxy is used for:
# - OpenAI API requests
# - YouTube API requests (video info, transcripts)
# - YouTube video playback for users in mainland China
# - YouTube video downloads (optional)
# Format: https://username:password@proxy-host:port
OPENAI_PROXY=
HTTPS_PROXY=

# YouTube Download Configuration (optional)
# To bypass YouTube's 403 restrictions, you can provide cookies from your browser
# Get cookies by: 1) Login to YouTube 2) Open DevTools > Network > Copy 'Cookie' header
# YOUTUBE_COOKIES=your-youtube-cookies-here

OPENAI_SYSTEM_PREFIX=你是一个AI助手。请直接回答用户的问题。

# DeepL Translation API Configuration
# DeepL provides high-quality translations with generous rate limits
# Free tier: 500,000 characters/month
# Sign up at: https://www.deepl.com/pro-api
DEEPL_API_KEY=
# API type: 'free' or 'pro' (default: free)
DEEPL_API_TYPE=free
# Timeout in milliseconds (default: 8000)
DEEPL_TIMEOUT_MS=8000

# Google Translate Configuration (optional, for fallback)
# Timeout in milliseconds (default: 8000)
GOOGLE_TRANSLATE_TIMEOUT_MS=8000

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Service Configuration
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=86400
AI_COST_TRACKING_ENABLED=true
AI_MAX_RETRY_ATTEMPTS=3

# Environment
NODE_ENV=development
PORT=4000
# Additional comma-separated origins allowed to call the API.
# Example: https://app.your-domain.com,https://staging.your-domain.com
CORS_ALLOWED_ORIGINS=
FORCE_LOCAL_VIDEO=false
FORCE_LOCAL_VIDEO_REQUIRE_FILE=false
LOCAL_VIDEO_INDEX_REFRESH_SEC=60

# Google OAuth Configuration
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: https://your-domain.com/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/oauth/google/callback
ENABLE_GOOGLE_OAUTH=false

# WeChat website QR login
# Create a website app at: https://open.weixin.qq.com
# Set the authorized callback to: https://your-domain.com/auth/oauth/wechat/callback
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=/auth/oauth/wechat/callback
ENABLE_WECHAT_OAUTH=false

# Frontend URL (for OAuth redirects)
FRONTEND_BASE_URL=http://localhost:4000
FRONTEND_ENABLE_GOOGLE_OAUTH=false
FRONTEND_ENABLE_WECHAT_OAUTH=false

# Frontend UI flags
# Show ICP record in footer (for mainland China sites)
FRONTEND_SHOW_ICP=false
# ICP record text (set your own registration if applicable)
FRONTEND_ICP_TEXT=
# Enable network upload entry (YouTube import)
FRONTEND_ENABLE_NETWORK_UPLOAD=true
# Waveform-assisted segmentation (frontend)
# Enable/disable waveform-assisted cuts (default: true)
FRONTEND_WAVEFORM_SEGMENTATION_ENABLED=true
# Only split segments longer than this duration (seconds)
FRONTEND_WAVEFORM_SEGMENTATION_MIN_DURATION_SEC=5.5
# Only split segments with at least this many words
FRONTEND_WAVEFORM_SEGMENTATION_MIN_WORDS=8
# Minimum silence duration to be considered a cut (seconds)
FRONTEND_WAVEFORM_SEGMENTATION_MIN_SILENCE_SEC=0.25
# Peak-relative silence threshold ratio (0-1)
FRONTEND_WAVEFORM_SEGMENTATION_THRESHOLD_RATIO=0.1
# Absolute minimum amplitude threshold
FRONTEND_WAVEFORM_SEGMENTATION_MIN_THRESHOLD=0.02
# Keep at least this distance from segment edges (seconds)
FRONTEND_WAVEFORM_SEGMENTATION_MIN_EDGE_SEC=0.25
# Minimum duration for a resulting sub-segment (seconds)
FRONTEND_WAVEFORM_SEGMENTATION_MIN_CHUNK_SEC=0.45
# Max number of segments to split per video
FRONTEND_WAVEFORM_SEGMENTATION_MAX_SPLITS=24
# Max number of splits per original segment
FRONTEND_WAVEFORM_SEGMENTATION_MAX_SPLITS_PER_SEGMENT=2

# JWT Token TTL (seconds, default: 24 hours)
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=86400
# Production defaults reject old unsigned MVP tokens. Temporarily set true only during migration.
AUTH_ALLOW_LEGACY_UNSIGNED_TOKENS=false
# Password reset links expire after this many minutes.
PASSWORD_RESET_TTL_MINUTES=30
# Development only: when true, /auth/password-reset/request returns a reset_url for local testing.
PASSWORD_RESET_DEBUG=false
# Email verification links expire after this many hours.
EMAIL_VERIFICATION_TTL_HOURS=48
# Development only: when true, registration/resend responses include a verification_url.
EMAIL_VERIFICATION_DEBUG=false
SUPPORT_EMAIL=support@example.com

# SMTP email delivery for password resets and email verification. Leave blank to use manual-support fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Linglish <no-reply@example.com>"

# Feature Flags
ENABLE_AI_TUTOR=true
ENABLE_AI_CHAT=true
ENABLE_DAILY_PLAN=true
ENABLE_CONTENT_RECOMMENDATION=true

# Cost Limits (USD)
AI_DAILY_BUDGET=10.00
AI_MONTHLY_BUDGET=300.00
AI_COST_ALERT_THRESHOLD=0.8
# Optional per-call estimates used by admin AI usage reports.
# Keep as 0 when the provider does not expose reliable per-call cost yet.
AI_DEEP_WORD_ESTIMATED_COST_CENTS=0
AI_PRONUNCIATION_ESTIMATED_COST_CENTS=0

# ── LemonSqueezy Payment Configuration ────────────────────────────────────────
# Get your API key from: https://app.lemonsqueezy.com/settings/api
LEMONSQUEEZY_API_KEY=

# Webhook signing secret from: https://app.lemonsqueezy.com/settings/webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=

# Checkout URLs for your product variants (from LemonSqueezy dashboard → Share)
# The legacy LEMONSQUEEZY_CHECKOUT_URL is still accepted as the monthly fallback.
LEMONSQUEEZY_CHECKOUT_URL_MONTHLY=
LEMONSQUEEZY_CHECKOUT_URL_YEARLY=
LEMONSQUEEZY_CHECKOUT_URL=
# Optional unsigned fallback. Signed Customer Portal URLs are preferred and fetched by subscription ID.
LEMONSQUEEZY_CUSTOMER_PORTAL_URL=
# Optional: used only for estimated MRR in admin business analytics.
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_YEARLY_VARIANT_ID=
LEMONSQUEEZY_MONTHLY_PRICE_CENTS=0
LEMONSQUEEZY_YEARLY_PRICE_CENTS=0

# Redirect URLs after LemonSqueezy Checkout completes
LEMONSQUEEZY_SUCCESS_URL=http://localhost:4000/pricing.html?success=1
LEMONSQUEEZY_CANCEL_URL=http://localhost:4000/pricing.html?cancelled=1
